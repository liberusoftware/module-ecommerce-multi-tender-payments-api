{
    "name": "liberusoftware/ecommerce-multi-tender-payments-api",
    "description": "HTTP presentation for Liberu Ecommerce Multi-Tender Payments: plans, admissions, an append-only tender ledger and outstanding balances, with every money figure resolved server-side.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-multi-tender-payments"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-multi-tender-payments": "^0.1.0"
    },
    "require-dev": {
        "liberusoftware/ecommerce-multi-tender-payments": "^0.1.0",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\MultiTenderPayments\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\MultiTenderPayments\\Api\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-multi-tender-payments-api"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
